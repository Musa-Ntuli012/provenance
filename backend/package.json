{
  "name": "@provenance/backend",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "PROVENANCE, private-firm engineering project management platform (API, Supabase-compatible PostgreSQL)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "start": "node src/server.js",
    "db:ping": "node src/db/ping.js",
    "db:bootstrap": "node src/db/bootstrap.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test tests/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
