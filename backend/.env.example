# PROVENANCE backend, copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# --------------------
# Supabase dashboard, Project Settings, Database:
#   Connection string, URI, choose the SESSION POOLER (port 5432).
#   It looks like:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (@ becomes %40).
#
# ADMIN connection (migrations, seed, bootstrap). Same URI:
DATABASE_URL_ADMIN=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# RUNTIME connection (every request, row-level-security constrained). First run
#   APP_ROLE_PASSWORD=<choose-a-runtime-password> npm run db:bootstrap
# then use the same host/db with the provenance_app role:
DATABASE_URL=postgresql://provenance_app:<runtime-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --------------------
# DATABASE_URL_ADMIN=postgresql://provenance_owner:<owner-password>@localhost:5432/provenance
# DATABASE_URL=postgresql://provenance_app:<runtime-password>@localhost:5432/provenance

# Session signing secret, at least 32 characters.
JWT_SECRET=generate-with-openssl-rand-hex-48
# Where uploaded documents are stored on disk.
STORAGE_DIR=./storage
# Comma separated allow-list for cross-origin calls only (leave empty when the
# frontend proxies the API same-origin, the default in this repo).
CORS_ORIGINS=
