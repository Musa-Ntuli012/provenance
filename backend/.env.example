# PROVENANCE backend, copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB connection string.
#   Local (replica set required for transactions):
MONGODB_URI=mongodb://localhost:27017/provenance?replicaSet=rs0
#   MongoDB Atlas (network access + user configured in the Atlas console):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/provenance
MONGODB_DB_NAME=provenance

# Session signing secret, at least 32 characters.
JWT_SECRET=generate-with-openssl-rand-hex-48
# Where uploaded documents are stored on disk.
STORAGE_DIR=./storage
# Comma separated allow-list for cross-origin calls only (leave empty when the
# frontend proxies the API same-origin, the default in this repo).
CORS_ORIGINS=
