# Docker Compose environment for PROVENANCE's local database.
# Copy to .env (repo root) before `docker compose up -d`.
# These are development secrets, generate your own for anything shared.

# Password for the schema-owner role (provenance_owner).
# Runs migrations and the seed script; bypasses row-level security.
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD

# Password for the runtime role (provenance_app).
# Every request-scoped query runs as this role, constrained by RLS.
APP_ROLE_PASSWORD=CHANGE_ME_APP_PASSWORD

# Host port for Postgres. Change if 5432 is already in use.
POSTGRES_HOST_PORT=5432
