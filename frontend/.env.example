# PROVENANCE frontend, copy to .env if you need to override defaults.
# All variables are OPTIONAL. Vite only exposes variables prefixed VITE_.

# Base URL for the API. Default: '' (empty) → same-origin requests to /api,
# which the Vite dev server proxies to http://127.0.0.1:4000 (see vite.config.ts).
# Set this ONLY when the API is served from a different origin in production,
# e.g. https://api.provenance.example.com  (the API's CORS_ORIGINS must then
# include the frontend origin, with credentials enabled).
VITE_API_BASE_URL=

# Example, split deployment:
# VITE_API_BASE_URL=https://api.provenance.example.com
